PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/malka
JWT_SECRET=
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173

# Cloudinary (comprobantes de pago). Sin esto, en local se guardan en uploads/.
# CLOUDINARY_URL=

# ── Emails ──────────────────────────────────────────────────────────────
# Se usa el primero que esté configurado: SMTP, después Resend. Sin ninguno,
# los avisos se loguean y no se manda nada. Ver GOOGLE_WORKSPACE_EMAIL_SETUP.md.
EMAIL_FROM="Malka <notificaciones@casamalka.org>"
# Adónde van las respuestas (una casilla que alguien lea).
# EMAIL_REPLY_TO=

# SMTP (Google Workspace SMTP Relay u otro proveedor SMTP)
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# Sólo si el relay pide autenticación (si autoriza por IP, dejar vacíos):
# SMTP_USER=
# SMTP_PASS=
# Nombre con el que el server se presenta (EHLO). Google lo exige.
# SMTP_EHLO_NAME=casamalka.org

# Alternativa por API HTTP (hostings que bloquean los puertos SMTP)
# RESEND_API_KEY=

# ── Notificaciones push ─────────────────────────────────────────────────
# Generar con: npm run push:keys  (una sola vez; si se cambian, todos los
# dispositivos tienen que volver a activar las notificaciones)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:notificaciones@casamalka.org
